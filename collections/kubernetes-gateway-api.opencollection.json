          "http": {
            "method": "POST",
            "url": "https://kubernetes.default.svc/apis/gateway.networking.k8s.io/v1/namespaces/:namespace/httproutes",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Namespace name to scope the request."
              },
              {
                "name": "dryRun",
                "value": "",
                "type": "query",
                "description": "If 'All', validates without persisting."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new HTTPRoute in the specified namespace. The HTTPRoute attaches to a Gateway listener and defines how matched HTTP requests are forwarded to backend services, with optional request/response filters."
        },
