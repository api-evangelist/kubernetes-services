                "name": "labelSelector",
                "value": "",
                "type": "query",
                "description": "Label selector to filter resources."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              },
              {
                "name": "watch",
                "value": "",
                "type": "query",
                "description": "If true, stream watch events."
              }
